# 编译产物
godb.exe
godb
*.exe
*.exe~
*.test
*.out

# 运行时数据（WAL / 快照 / 表结构），首次启动会自动生成
godb-data/
godb-data.bak/
# 换存储格式时留档的旧数据目录（别提交，里面是几 MB 的数据文件）
godb-data.*/
# 带时间戳的备份（拉上游前手动做的；lost-* 是事故现场保留目录）
godb-data.bak-*/
godb-data.lost-*/
godb.exe.bak-*
config.json.bak-*

# 调试用的临时截图
_shot_*.png

# 日志与临时文件
*.log
pg-queries.log
tmp-*
.DS_Store
Thumbs.db
